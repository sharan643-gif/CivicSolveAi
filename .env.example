# CivicSolve AI Environment Variables Configuration
# Copy this file to '.env' and fill in your keys.

# Supabase Configurations
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anonymous-public-key

# Groq AI Configuration (Production AI Engine for Civic Chat, Classification, Summarization & Priority)
# Obtain your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound

# OpenRouter AI Configuration (Fallback / Alternative AI)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
